{
  "name": "world-news-digest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "tsx src/index.ts",
    "digest": "tsx src/index.ts",
    "serve": "tsx server/index.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "npm run test:node && npm run test:web",
    "test:node": "tsx --test tests/*.test.ts",
    "test:web": "vitest run --config web/vite.config.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
